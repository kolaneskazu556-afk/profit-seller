# Скопируйте в .env (setup.sh делает это сам). Файл .env НЕЛЬЗЯ коммитить в GitHub.
DB_PATH=/var/lib/wbozon/data.db
RETENTION_DAYS=30
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Корневой сертификат Минцифры в PEM (setup.sh пробует скачать). Если пусто и TLS не проходит:
GIGACHAT_CA_BUNDLE=/opt/wbozon/certs/russian_ca.pem
# GIGACHAT_VERIFY_SSL=false   # небезопасный запасной вариант
# Адрес Healthchecks.io (или аналога) для контроля, что бэкап выполняется
HC_URL=
